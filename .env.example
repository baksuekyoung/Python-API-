# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤,
# 아래 = 뒤에 본인이 발급받은 실제 키 값을 입력하세요.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# .env 파일 자체는 절대 깃허브 등에 올리지 마세요. (.gitignore에 이미 등록되어 있습니다)

GEMINI_API_KEY=여기에_Gemini_API_키를_붙여넣으세요
KAKAO_REST_API_KEY=여기에_Kakao_REST_API_키를_붙여넣으세요
